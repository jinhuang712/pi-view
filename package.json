{
  "name": "pid-view",
  "private": false,
  "version": "0.1.0",
  "description": "A Pi extension for image viewing and vision-model routing.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "pi", "vision", "images"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinhuang712/pid-view.git"
  },
  "bugs": {
    "url": "https://github.com/jinhuang712/pid-view/issues"
  },
  "homepage": "https://github.com/jinhuang712/pid-view#readme",
  "files": [
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pid": {
    "ui": "./src/ui.tsx"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "image-size": "^2.0.2",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.20.2",
    "typescript": "7.0.2"
  }
}
